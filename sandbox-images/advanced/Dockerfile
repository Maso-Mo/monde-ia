# ============================================================
# ZFLM - Sandbox "advanced" (placeholder Phase 1+)
# ============================================================
# Cette image sera définie quand les niveaux avancés seront
# implémentés (projets ambitieux). Pour l'instant on laisse
# un placeholder qui build une image triviale à partir de
# python:3.12-slim (déjà préchargé).
#
# Raison : éviter un fichier Dockerfile vide qui ferait
# échouer un éventuel `docker build` accidentel.

FROM python:3.12-slim

LABEL org.opencontainers.image.title="zflm-sandbox-advanced" \
      org.opencontainers.image.description="Placeholder - Phase 1+" \
      org.opencontainers.image.source="https://github.com/Maso-Mo/monde-ia"

RUN echo "ZFLM sandbox advanced : à définir en Phase 1"

CMD ["python", "-c", "print('ZFLM sandbox advanced placeholder')"]