# ============================================================
# ZFLM - Monde des LLM - Variables d'environnement (exemple)
# ============================================================
# Copier ce fichier vers .env puis remplir les valeurs réelles.
# NE JAMAIS committer de vrai .env.
#
# IMPORTANT :
#   - OpenRouter sert UNIQUEMENT pendant le développement
#     de l'orchestrateur ZFLM.
#   - FreeLLMAPI est la passerelle finale de l'expérience.
#     Il s'exécute comme service tiers séparé.

# --- Orchestrateur ---
ZFLM_LOG_LEVEL=INFO
ZFLM_DB_PATH=/app/memory/zflm.db
ZFLM_PROJECTS_DIR=/app/projects
ZFLM_MEMORY_DIR=/app/memory
ZFLM_LOGS_DIR=/app/logs
ZFLM_MAX_ATTEMPTS_PER_TASK=3
ZFLM_GIT_USER_NAME=ZFLM Bot
ZFLM_GIT_USER_EMAIL=bot@example.invalid

# --- FreeLLMAPI (service externe tiers) ---
# URL où FreeLLMAPI sera joignable depuis l'orchestrateur.
# FreeLLMAPI est un projet séparé, NON inclus dans ce repo.
FREELLMAPI_URL=http://freellmapi:8080

# --- OpenRouter (DEV UNIQUEMENT, pas pour l'expérience finale) ---
# Laisser vide en production.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Modèles utilisés par l'expérience ---
ZFLM_GENERATOR_MODEL=
ZFLM_REVIEWER_MODEL=
ZFLM_VALIDATOR_MODEL=

# --- Limites ---
ZFLM_MAX_ATTEMPTS_PER_TASK=3