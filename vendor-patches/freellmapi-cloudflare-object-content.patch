diff --git a/server/src/__tests__/lib/content.test.ts b/server/src/__tests__/lib/content.test.ts
index b555f6d..506e14b 100644
--- a/server/src/__tests__/lib/content.test.ts
+++ b/server/src/__tests__/lib/content.test.ts
@@ -216,6 +216,63 @@ describe('normalizeOutboundContent (#166)', () => {
       const out = normalizeOutboundContent(result, 'cloudflare');
       expect(out.choices[0].message.content).toBe('plain string');
     });
+
+    it('prevents empty-completion false positive for Cloudflare object content (non-stream path)', () => {
+      // This test simulates the exact scenario from the proxy non-streaming path:
+      // 1. Cloudflare returns an object in message.content
+      // 2. normalizeOutboundContent is called with platform='cloudflare'
+      // 3. contentToString is called on the normalized content (as done in proxy.ts)
+      // 4. The result should be a non-empty JSON string, not ''
+      const cloudflareObject = {
+        issues_found: ['SyntaxError: Unexpected token ;'],
+        severity: 'critical',
+        instructions_for_fix: ['Add semicolon after statement'],
+        retry_needed: true,
+      };
+      const result = { choices: [{ index: 0, message: { role: 'assistant', content: cloudflareObject } }] };
+
+      // Step 1: Normalize (what proxy.ts now does early)
+      const normalized = normalizeOutboundContent(result, 'cloudflare');
+
+      // Step 2: contentToString check (what proxy.ts empty-completion check does)
+      const respMsg = normalized.choices?.[0]?.message;
+      const respText = contentToString(respMsg?.content ?? '');
+
+      // The content should be a JSON string, not empty
+      expect(respText).not.toBe('');
+      expect(respText).toBe(JSON.stringify(cloudflareObject));
+
+      // content should be the JSON string, not the original object
+      expect(typeof respMsg?.content).toBe('string');
+      expect(respMsg?.content).toBe(JSON.stringify(cloudflareObject));
+    });
+
+    it('still treats genuinely empty content as empty for Cloudflare', () => {
+      // Cloudflare returning null/undefined should still be treated as empty
+      const resultNull = { choices: [{ index: 0, message: { role: 'assistant', content: null } }] };
+      const normalizedNull = normalizeOutboundContent(resultNull, 'cloudflare');
+      const respTextNull = contentToString(normalizedNull.choices?.[0]?.message?.content ?? '');
+      expect(respTextNull).toBe('');
+
+      const resultUndefined = { choices: [{ index: 0, message: { role: 'assistant', content: undefined } }] };
+      const normalizedUndefined = normalizeOutboundContent(resultUndefined, 'cloudflare');
+      const respTextUndefined = contentToString(normalizedUndefined.choices?.[0]?.message?.content ?? '');
+      expect(respTextUndefined).toBe('');
+    });
+
+    it('non-Cloudflare providers still pass objects through (existing behavior)', () => {
+      // For non-Cloudflare, objects are NOT serialized, so contentToString returns ''
+      // This is the EXISTING behavior - we don't change it
+      const result = { choices: [{ index: 0, message: { role: 'assistant', content: cloudflareObject } }] };
+      const normalized = normalizeOutboundContent(result, 'groq');
+      const respMsg = normalized.choices?.[0]?.message;
+      const respText = contentToString(respMsg?.content ?? '');
+
+      // Object passes through unchanged
+      expect(respMsg?.content).toBe(cloudflareObject);
+      // contentToString returns '' for objects (existing behavior)
+      expect(respText).toBe('');
+    });
   });
 });
 
